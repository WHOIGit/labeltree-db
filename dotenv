# Template for .env

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=  # YOUR SECRET KEY
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# true in production behind Apache (config/apache2/): trusts its X-Forwarded-Proto
# and sends cookies over HTTPS only. Staging, e.g.:
#   DJANGO_ALLOWED_HOSTS=labeltree-staging.whoi.edu
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://labeltree-staging.whoi.edu
DJANGO_BEHIND_TLS_PROXY=false

# Created on container start by `manage.py ensure_superuser` if missing.
# Leave username or password empty to skip.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=  # YOUR SUPERUSER PASSWORD

# Shared by Django and the postgres container.
POSTGRES_DB=labeltree
POSTGRES_USER=labeltree
POSTGRES_PASSWORD=  # YOUR DB PASSWORD
POSTGRES_HOST=
#POSTGRES_PORT=5432
