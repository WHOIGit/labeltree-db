---
title: "Merge with replacement"
---
%% MERGE WITH REPLACEMENT: A and B are both deprecated; a new node C replaces them
flowchart LR
    subgraph before["before"]
        direction TB
        P1[P] --> A1[A] --> a1_1[a1] & a2_1[a2]
        P1 --> B1[B] --> b1_1[b1]
    end
    subgraph ops["atomic changes · merge#2"]
        direction TB
        r1["1 · add C under P"] --> r2["2 · move a1 → C"] --> r3["3 · move a2 → C"] --> r4["4 · move b1 → C"] --> r5["5 · deprecate A<br/>successors = [C]"] --> r6["6 · deprecate B<br/>successors = [C]"]
    end
    subgraph after["after"]
        direction TB
        P2[P] --> N[C] --> a1_2[a1] & a2_2[a2] & b1_2[b1]
        Ad["A (deprecated)"] -. successor .-> N
        Bd["B (deprecated)"] -. successor .-> N
    end
    before --> ops --> after

    classDef dep fill:#e5e7eb,stroke:#6b7280,stroke-dasharray:4 3,color:#6b7280
    classDef new fill:#bbf7d0,stroke:#15803d
    class Ad,Bd dep
    class N new
