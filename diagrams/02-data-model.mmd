erDiagram
    TREE ||--o{ TREE_REVISION : "has revisions"
    TREE ||--o{ NODE : owns
    TREE ||--o{ CHANGESET : "edited by"
    NODE ||--|{ NODE_VERSION : "has versions"
    TREE_REVISION ||--o{ NODE_VERSION : "valid_from / valid_to"
    NODE_VERSION }o--o| WORMS_RECORD : "aphia_id (cache)"
    NODE ||--o{ NODE_ALIAS : "aliases (unversioned)"
    NODE ||--o| NODE_FLAGS : "current flags"
    NODE ||--o{ SUCCESSOR : "if deprecated"
    NODE_VERSION }o--o| NODE : "parent (null = top-level)"
    SUCCESSOR }o--|| NODE : "points to"
    CHANGESET ||--o{ CHANGE : "ordered (seq)"
    CHANGESET |o--o| TREE_REVISION : "publishes"
    CHANGE }o--o| NODE_VERSION : "produces"

    TREE {
        slug id PK
        string title
        string description
    }
    TREE_REVISION {
        slug tree FK
        int number
        int changeset FK
        datetime published_at
        string published_by
        string notes
    }
    NODE {
        int id PK "global, never reused"
        slug tree FK
        int added_in_rev
        int created_by_change FK
        int deprecated_in_rev "null = still in tree"
    }
    NODE_VERSION {
        int node FK
        int version
        int valid_from_rev
        int valid_to_rev "null = current"
        string label "machine-safe, not unique"
        int parent FK
        int aphia_id "nullable"
        string description
        int change FK "provenance"
    }
    NODE_ALIAS {
        int node FK
        string alias "free text"
        string added_by
        datetime added_at
    }
    NODE_FLAGS {
        int node FK
        jsonb flags "current WoRMS placement warnings"
        datetime computed_at
    }
    WORMS_RECORD {
        int aphia_id
        jsonb record "name, rank, status, lineage"
        datetime fetched_at
        datetime worms_modified
    }
    SUCCESSOR {
        int deprecated_node FK
        int successor_node FK
    }
    CHANGESET {
        string state
        int base_rev
        string author
        string approved_by
    }
    CHANGE {
        int seq
        string op "add | edit | move | deprecate"
        string group "macro id, e.g. split#3"
        jsonb payload
        jsonb checks
    }
