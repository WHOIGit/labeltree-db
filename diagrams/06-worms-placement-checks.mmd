flowchart TD
    start(["for each node N to recheck:<br/>N itself,<br/>nearest anchored descendants,<br/>same-aphia nodes"]) --> hasref{"N has<br/>aphia_id?"}
    hasref -- no --> skip["N skipped as anchor<br/>(its descendants still checked)"]
    hasref -- yes --> fetch["live fetch: AphiaRecordByID(a)<br/>+ AphiaClassificationByAphiaID(a)"]
    fetch --> reach{"WoRMS reachable?"}
    reach -- no --> unavail["checks: unavailable<br/>(publish still allowed)"]
    reach -- yes --> c1{"status accepted?"}
    c1 -- no --> f1["⚠ unaccepted_aphia<br/>suggest valid_AphiaID"]
    c1 -- yes --> c2
    f1 --> c2["A = nearest ancestor with aphia_id<br/>(walk up, skipping un-anchored nodes)"]
    c2 --> c3{"A.aphia in lineage(a)?"}
    c3 -- no --> f3["⚠ out_of_lineage"]
    c3 -- yes --> c7
    f3 --> c7
    c7{"another node in tree<br/>with same exact aphia?"}
    c7 -- yes --> f7["⚠ duplicate_aphia"]
    c7 -- no --> done
    f7 --> done(["store flags on change;<br/>on publish overwrite current NODE_FLAGS<br/>(no history, no version bump)"])

    classDef warn fill:#fde68a,stroke:#b45309
    class f1,f3,f7,unavail warn
